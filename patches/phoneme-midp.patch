+        int kept = 0;
+        byte[] buf = new byte[COMPACT_BUFFER_SIZE];
+        for (int i = 0; i < liveCount; i++) {
+            int from = liveOffsets[i];
+            int size = liveSizes[i];
+            int done = 0;
+            while (done < size) {
