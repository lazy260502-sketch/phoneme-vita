+/* ---- Touch: front panel -> MIDP_PEN_EVENT ----
+ * SceTouch reports in a 0..4095 space per axis regardless of dst panel
+ * geometry; map through the on-screen viewport to virtual 240x320 phone
+ * coordinates. State machine: no finger -> PRESSED on first report,
+ * movement while down -> DRAGGED, finger gone -> RELEASED. */
+static int pen_down = 0;          /* pen currently on screen */
+static int pen_last_x, pen_last_y;
+static int touch_initialized = 0;
+
+static void touch_poll(void) {
+    SceTouchData td;
+    int vx, vy, vw, vh;
+
+    if (!touch_initialized) {
+        sceTouchSetSamplingState(SCE_TOUCH_PORT_FRONT,
+                                 SCE_TOUCH_SAMPLING_STATE_START);
+        touch_initialized = 1;
+    }
+
+    if (sceTouchPeek(SCE_TOUCH_PORT_FRONT, &td, 1) < 0) {
+        return;
+    }
+
+    vita_display_get_viewport(&vx, &vy, &vw, &vh);
+    if (vw <= 0 || vh <= 0) {
+        return; /* display not initialized yet */
+    }
+
+    if (td.reportNum > 0) {
+        int px = td.report[0].x; /* 0..4095 */
+        int py = td.report[0].y;
+        int lx, ly;
+
+        if (px < vx || py < vy || px >= vx + vw || py >= vy + vh) {
+            return; /* touched outside the phone screen area */
+        }
+
+        lx = (int)(((long long)(px - vx) * 10000) / vw);
+        ly = (int)(((long long)(py - vy) * 10000) / vh);
+        lx = (lx * gxj_virt_w()) / 10000;
+        ly = (ly * gxj_virt_h()) / 10000;
+
+        if (!pen_down) {
+            pen_down = 1;
+            emit_pen_event(lx, ly, KEYMAP_STATE_PRESSED);
+        } else if (lx != pen_last_x || ly != pen_last_y) {
+            emit_pen_event(lx, ly, KEYMAP_STATE_DRAGGED);
+        }
+        pen_last_x = lx;
+        pen_last_y = ly;
+    } else if (pen_down) {
+        pen_down = 0;
+        emit_pen_event(pen_last_x, pen_last_y, KEYMAP_STATE_RELEASED);
+    }
+}
