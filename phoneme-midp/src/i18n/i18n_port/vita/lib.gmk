#
# Vita generic charset converter.
#
# Selected by USE_I18N_VITA=true (build/vita_arm/Settings.gmk,
# build_vita.sh).  The upstream "default" port compiles
# defaultGenConv.c, whose getLcGenConvMethods() returns NULL, i.e. every
# charset that is not a dedicated Java class (ISO8859_1, UTF_8/16) ends in
# UnsupportedEncodingException.  J2ME games do use SJIS/EUC-JP/EUC-KR/GBK/
# Big5, so on this platform the real converter replaces the stub.
#
# The tables (vita_charmap.h) are generated by
# tools/charsetgen/gen_charmap.py and verified against Python's codecs by
# tools/charsetgen/verify_charsets.py.
#
######################################################################

vpath % $(I18N_PORT_DIR)/vita/native
# The locale half of the port (getLocaleInfo, used by midp_i18n's
# localeMethod.c) has no Vita-specific behaviour, so reuse the upstream
# default implementation instead of forking it.  Only the converter is
# replaced.
vpath % $(I18N_PORT_DIR)/default/native

SUBSYSTEM_I18N_EXTRA_INCLUDES += \
    -I$(I18N_PORT_DIR)/vita/native

ifeq ($(TARGET_VM), cldc_vm)
SUBSYSTEM_I18N_NATIVE_FILES  += \
    defaultLocale.c \
    vitaGenConv.c
endif
