#!/bin/bash
# Step 1: Rebuild CLDC library if needed

source "$(dirname "${BASH_SOURCE[0]}")/build_midp_vita.common"

build_section "[Step 1] Checking CLDC modifications..."

UNIVERSE_SRC="$CLDC_DIR/src/vm/share/handles/Universe.cpp"
JVMSPI_HDR="$CLDC_DIR/src/vm/share/runtime/jvmspi.h"
CLDC_LIB="$CLDC_DIR/build/vita_arm/dist/lib/libcldc_vm_g.a"

REBUILD_CLDC=0

# Check if any key source changed
if file_changed "$UNIVERSE_SRC" "$BUILD_DIR/.cldc_universe.md5"; then
    build_warn "Changed: Universe.cpp"
    REBUILD_CLDC=1
fi

if file_changed "$JVMSPI_HDR" "$BUILD_DIR/.cldc_jvmspi.md5"; then
    build_warn "Changed: jvmspi.h"
    REBUILD_CLDC=1
fi

# Check if VPK was built with old CLDC
if [ -f "$VPK_OUTPUT" ] && [ -f "$CLDC_MARKER" ]; then
    if [ "$VPK_OUTPUT" -nt "$CLDC_MARKER" ]; then
        build_warn "VPK is newer than CLDC marker"
        REBUILD_CLDC=1
    fi
fi

# Initial build check
if [ ! -f "$CLDC_MARKER" ]; then
    build_info "No CLDC marker, initial build"
    REBUILD_CLDC=1
fi

# External trigger (ROM changed)
if [ "$ROM_FORCE_REBUILD" = "1" ]; then
    build_warn "ROM changed, forcing CLDC rebuild"
    REBUILD_CLDC=1
fi

if [ "$REBUILD_CLDC" = "1" ]; then
    build_info "Rebuilding MergedSrc004.o..."
    
    # Backup original libraries first
    if [ ! -f "$CLDC_DIR/build/vita_arm/dist/lib/libcldc_vm_g.a.original" ]; then
        cp "$CLDC_DIR/build/vita_arm/dist/lib/libcldc_vm_g.a" "$CLDC_DIR/build/vita_arm/dist/lib/libcldc_vm_g.a.original"
        cp "$CLDC_DIR/build/vita_arm/dist/lib/libcldc_vm.a" "$CLDC_DIR/build/vita_arm/dist/lib/libcldc_vm.a.original"
    fi
    
    # Compile to a known location
    MERGED_O="/tmp/_MergedSrc004_step1.o"
    cd "$CLDC_DIR/build/vita_arm/target/debug"
    
    /home/zyb/.local/vitasdk/bin/g++ \
        -g -DARM -DVITA -D__PSP2__ -Wno-narrowing -fpermissive \
        -marm -march=armv7-a -mtune=cortex-a9 -mfloat-abi=hard -mfpu=vfpv3 \
        -DSUPPORTS_MEMORY_MAPPED_FILES=0 -DSUPPORTS_ADJUSTABLE_MEMORY_CHUNK=0 \
        -DSUPPORTS_TIMER_THREAD=1 -DSUPPORTS_TIMER_INTERRUPT=0 \
        -DUSE_VM_EXCEPTIONS=0 -DUSE_BSD_SOCKET=1 \
        -D_DEBUG -DAZZERT -pipe -DGCC -Wreturn-type -Wparentheses -Wformat \
        -fstrict-aliasing -DREQUIRES_JVMCONFIG_H=1 \
        -DHARDWARE_LITTLE_ENDIAN=1 -DHOST_LITTLE_ENDIAN=1 \
        -DMSW_FIRST_FOR_DOUBLE=1 -DROMIZING=1 \
        -DJVM_RELEASE_VERSION='"1.2"' -DJVM_BUILD_VERSION='"internal"' \
        -DJVM_NAME='"phoneME Feature VM"' \
        -fno-gnu-keywords -fno-operator-names -fno-exceptions -fno-optional-diags -fno-rtti \
        -I"../generated" \
        -I"$CLDC_DIR/src/vm/share/compiler" \
        -I"$CLDC_DIR/src/vm/share/debugger" \
        -I"$CLDC_DIR/src/vm/share/handles" \
        -I"$CLDC_DIR/src/vm/share/memory" \
        -I"$CLDC_DIR/src/vm/share/interpreter" \
        -I"$CLDC_DIR/src/vm/share/isolate" \
        -I"$CLDC_DIR/src/vm/share/natives" \
        -I"$CLDC_DIR/src/vm/share/reflection" \
        -I"$CLDC_DIR/src/vm/share/runtime" \
        -I"$CLDC_DIR/src/vm/share/utilities" \
        -I"$CLDC_DIR/src/vm/share/ROM" \
        -I"$CLDC_DIR/src/vm/share/verifier" \
        -I"$CLDC_DIR/src/vm/share/float" \
        -I"$CLDC_DIR/src/vm/os/utilities" \
        -I"$CLDC_DIR/src/vm/share/memoryprofiler" \
        -I"$CLDC_DIR/src/vm/os/vita" \
        -I"$CLDC_DIR/src/midp" \
        -I"$CLDC_DIR/src/vm/cpu/arm" \
        -I"$CLDC_DIR/src/vm/cpu/c" \
        -I"$CLDC_DIR/src/vm/cpu/i386" \
        -I"$CLDC_DIR/src/vm/cpu/sh" \
        -I"$CLDC_DIR/src/vm/cpu/thumb" \
        -I"$CLDC_DIR/src/vm/cpu/thumb2" \
        -I"$CLDC_DIR/src/anilib/share" \
        -I"$CLDC_DIR/src/anilib/vita" \
        -I"$CLDC_DIR/src/tools/ads_extender" \
        -c ../generated/_MergedSrc004.cpp -o "$MERGED_O" 2>&1 | grep -E "error" || true
    
    if [ -f "$MERGED_O" ]; then
        cd "$CLDC_DIR/build/vita_arm"
        # Remove old object and add new one
        arm-vita-eabi-ar d dist/lib/libcldc_vm_g.a _MergedSrc004.o 2>/dev/null || true
        arm-vita-eabi-ar r dist/lib/libcldc_vm_g.a "$MERGED_O"
        arm-vita-eabi-ar d dist/lib/libcldc_vm.a _MergedSrc004.o 2>/dev/null || true
        arm-vita-eabi-ar r dist/lib/libcldc_vm.a "$MERGED_O"
        rm -f "$MERGED_O"

        # Save checksums
        md5sum "$UNIVERSE_SRC" | cut -d' ' -f1 > "$BUILD_DIR/.cldc_universe.md5"
        md5sum "$JVMSPI_HDR" | cut -d' ' -f1 > "$BUILD_DIR/.cldc_jvmspi.md5"
        touch "$CLDC_MARKER"

        # Clean VPK
        rm -f "$VPK_OUTPUT" midp_vita.velf midp_vita.self

        build_success "CLDC rebuilt"
    else
        build_error "Failed to compile MergedSrc004.o"
        exit 1
    fi
else
    build_info "CLDC up to date"
fi

# Export for other modules
export REBUILD_CLDC
