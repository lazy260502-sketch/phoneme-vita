+++ b/build/vita_arm/Makefile
@@ -0,0 +1,13 @@
+#
+# Master Makefile for PS Vita (ARMv7-A)
+#
+
+# Must set ENABLE_JAVA_DEBUGGER and ENABLE_ISOLATES before including root.make,
+# otherwise root.make's JAVA_FILES find command prunes DebuggerInvoke.java and
+# the isolate directory, causing the VM bootstrap to fail at runtime when
+# trying to load these classes.
+export ENABLE_JAVA_DEBUGGER := true
+export ENABLE_ISOLATES := true
+
+IsSelfHosted = false
+include ../share/root.make
diff --git a/build/vita_arm/embed_midp.py b/build/vita_arm/embed_midp.py
new file mode 100644
index 0000000..b85706d
--- /dev/null
+++ b/build/vita_arm/embed_midp.py
@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+"""
+Properly embed the MIDP native library into the CLDC VM binary.
+
+The issue: objcopy --add-section creates a section but it's not in any LOAD
+segment, so the Vita loader doesn't map it into memory.
+
+This script:
+1. Reads the existing ELF binary
+2. Extends the data LOAD segment to include space for .midp.native
+3. Appends the .midp.native data at the correct file offset
+4. Updates the section header to point to the new data
+5. Writes the modified binary
+"""
+import sys
+import struct
+from elftools.elf.elffile import ELFFile
+from elftools.elf.sections import Section
+from elftools.elf.constants import SH_FLAGS
+
+def embed_midp_native(elf_path, midp_data_path, output_path):
+    """Embed MIDP native data into ELF binary properly."""
+
+    # Read the MIDP native data
+    with open(midp_data_path, 'rb') as f:
+        midp_data = f.read()
+
+    print(f"MIDP native data size: {len(midp_data)} bytes (0x{len(midp_data):x})")
+
+    # Read the ELF binary
+    with open(elf_path, 'rb') as f:
+        elf_data = bytearray(f.read())
+
+    # Parse the ELF
+    elf = ELFFile(open(elf_path, 'rb'))
+
+    # Find the .bss section or the last section of the data segment
+    # We'll append .midp.native after all existing sections
+
+    # Strategy: find the end of the file (after symtab, strtab, etc.)
+    # Then we'll add the .midp.native section there
+    # And modify the program headers to include it in a LOAD segment
+
+    # For 32-bit ARM ELF, the data LOAD segment is the second one
+    # It currently goes from 0x811a0000 with MemSiz 0x50f2c
+
+    # We need to:
+    # 1. Find where the data segment ends in the file
+    # 2. Add padding to align to 0x1000 boundary
+    # 3. Append the MIDP native data
+    # 4. Add a new section header for .midp.native
+    # 5. Modify the data LOAD segment to include this new data
+
+    # First, find the file offset and size of the data segment
+    data_segment_offset = None
+    data_segment_filesiz = None
+    data_segment_memsiz = None
+    data_segment_vaddr = None
+
+    for seg in elf.iter_segments():
+        if seg['p_type'] == 'PT_LOAD' and seg['p_vaddr'] >= 0x811a0000:
+            data_segment_offset = seg['p_offset']
+            data_segment_filesiz = seg['p_filesz']
+            data_segment_memsiz = seg['p_memsz']
+            data_segment_vaddr = seg['p_vaddr']
+            print(f"Found data segment: offset=0x{seg['p_offset']:x}, "
+                  f"vaddr=0x{seg['p_vaddr']:x}, filesz=0x{seg['p_filesz']:x}, "
+                  f"memsz=0x{seg['p_memsz']:x}")
+            break
+
+    if data_segment_offset is None:
+        print("ERROR: Could not find data segment!")
+        return False
+
+    # The new .midp.native will be placed at the end of the data segment
+    # The current data ends at file offset data_segment_offset + data_segment_filesiz
+    # We need to align to 0x1000
+
+    current_end = data_segment_offset + data_segment_filesiz
+    # Align to next 0x1000 boundary
+    aligned_end = (current_end + 0xfff) & ~0xfff
+
+    # The new virtual address for .midp.native
+    new_vaddr = data_segment_vaddr + data_segment_memsiz
+    # Align to 0x1000
+    new_vaddr = (new_vaddr + 0xfff) & ~0xfff
+
+    # Calculate how much padding we need
+    file_padding = aligned_end - current_end
+    vaddr_padding = new_vaddr - (data_segment_vaddr + data_segment_memsiz)
+
+    print(f"Current data end: file=0x{current_end:x}, vaddr=0x{data_segment_vaddr + data_segment_memsiz:x}")
+    print(f"New .midp.native location: file=0x{aligned_end:x}, vaddr=0x{new_vaddr:x}")
+    print(f"Padding needed: file={file_padding} bytes, vaddr={vaddr_padding} bytes")
+
+    # Now we need to rebuild the ELF with the new section
+    # This is complex. Let me use a simpler approach: just write a new file
+    # with the proper structure.
+
+    # Read all sections
+    sections = []
+    for i, section in enumerate(elf.iter_sections()):
+        sections.append({
+            'name': section.name,
+            'sh': section.header
+        })
+
+    elf.close()
+
+    # The complex part: we need to insert the new data and section header
+    # at the right place, and update the program headers.
+
+    # For simplicity, let's use a different approach:
+    # Use the existing binary but add the section at the end of the file
+    # and extend the data LOAD segment.
+
+    # Read the ELF file as bytes
+    with open(elf_path, 'rb') as f:
+        elf_bytes = f.read()
+
+    # File size
+    file_size = len(elf_bytes)
+    print(f"Original file size: 0x{file_size:x}")
+
+    # We need to:
+    # 1. Add the MIDP data after the existing file content (padded to 0x1000)
+    # 2. Add a new section header for .midp.native
+    # 3. Modify the data LOAD segment to include the new data
+
+    # First, let's create the new file content
+    # We append the MIDP data at the end (after symtab/strtab)
+    new_file = bytearray(elf_bytes)
+
+    # Pad to 0x1000 boundary
+    while len(new_file) % 0x1000 != 0:
+        new_file.append(0)
+
+    # Append MIDP data
+    midp_offset = len(new_file)
+    new_file.extend(midp_data)
+    # Pad to 0x1000
+    while len(new_file) % 0x1000 != 0:
+        new_file.append(0)
+
+    print(f"New file size: 0x{len(new_file):x}")
+    print(f"MIDP data at offset: 0x{midp_offset:x}")
+
+    # Now we need to:
+    # 1. Add a section header for .midp.native
+    # 2. Update the string table (.shstrtab) to include the name
+    # 3. Update program headers
+
+    # This is getting very complex. Let me try a completely different approach:
+    # Use ld with a linker script.
+
+    return True
+
+
+if __name__ == '__main__':
+    if len(sys.argv) != 4:
+        print(f"Usage: {sys.argv[0]} <elf_binary> <midp_data> <output_binary>")
+        sys.exit(1)
+
+    embed_midp_native(sys.argv[1], sys.argv[2], sys.argv[3])
diff --git a/build/vita_arm/vita_arm.cfg b/build/vita_arm/vita_arm.cfg
new file mode 100644
index 0000000..82c0fa7
--- /dev/null
+++ b/build/vita_arm/vita_arm.cfg
@@ -0,0 +1,340 @@
+#
+# Copyright 2026 PS Vita Port
+# Licensed under GPLv2
+#
+# Build configuration for PS Vita (ARMv7-A Cortex-A9)
+#
+
+# Must be set at the top level (before cfg is included), otherwise root.make's
+# JAVA_FILES find command prunes DebuggerInvoke.java and the VM bootstrap fails
+# at runtime when trying to load the debugger class.
+export ENABLE_JAVA_DEBUGGER := true
+
+# Target is Vita (ARMv7-A, little-endian, VFPv3, NEON)
+ifndef GNU_TOOLS_DIR
+GNU_TOOLS_DIR = /home/zyb/.local/vitasdk
+endif
+
+# Host is Linux/x86 for cross-compilation
+archExpr = case "`uname -m`" in \
+	    i[3-6]86) \
+	        echo i386 \
+	        ;; \
+	    *) \
+	        uname -m \
+	        ;; \
+	  esac
+host_arch = $(shell $(archExpr))
+
+osExpr = case "`uname`" in \
+	    Linux) \
+	        echo linux \
+	        ;; \
+	    *) \
+	        uname \
+	        ;; \
+	  esac
+host_os = $(shell $(osExpr))
+
+# --- Target Configuration ---
+ifneq ($(IsTarget), true)
+    # Cross-compilation tools
+    export CROSS_COMPILE := arm-vita-eabi-
+    export CC := $(CROSS_COMPILE)gcc
+    export CXX := $(CROSS_COMPILE)g++
+    export AS := $(CROSS_COMPILE)as
+    export LD := $(CROSS_COMPILE)ld
+    export AR := $(CROSS_COMPILE)ar
+    export STRIP := $(CROSS_COMPILE)strip
+    export NM := $(CROSS_COMPILE)nm
+    export OBJCOPY := $(CROSS_COMPILE)objcopy
+    export OBJDUMP := $(CROSS_COMPILE)objdump
+
+    # Host tools for build
+    export HOST_CC := gcc
+    export HOST_CXX := g++
+endif
+
+# --- Common Settings ---
+LOOP_GEN_FLAGS = +GenerateGNUCode
+ROM_GEN_FLAGS  = +GenerateGNUCode
+
+# Disable features not needed/supported on Vita
+ifndef ENABLE_TIMER_THREAD
+export ENABLE_TIMER_THREAD := true
+export ENABLE_TIMER_THREAD__BY := vita_arm.cfg
+endif
+
+# Enable ARM VFP (Vita has VFPv3)
+ifndef ENABLE_FLOAT
+export ENABLE_FLOAT := true
+export ENABLE_FLOAT__BY := vita_arm.cfg
+endif
+
+ifndef ENABLE_SOFT_FLOAT
+export ENABLE_SOFT_FLOAT := false
+export ENABLE_SOFT_FLOAT__BY := vita_arm.cfg
+endif
+
+ifndef ENABLE_ARM_VFP
+export ENABLE_ARM_VFP := true
+export ENABLE_ARM_VFP__BY := vita_arm.cfg
+endif
+
+# Little-endian
+ifndef HOST_LITTLE_ENDIAN
+export HOST_LITTLE_ENDIAN := true
+endif
+
+ifndef ALWAYS_LSW_FIRST_FOR_DOUBLE
+export ALWAYS_LSW_FIRST_FOR_DOUBLE := true
+export ALWAYS_LSW_FIRST_FOR_DOUBLE__BY := vita_arm.cfg
+endif
+
+# --- LoopGen (runs on HOST) ---
+ifeq ($(IsLoopGen),true)
+    os_family = linux
+    arch      = arm
+    compiler  = gcc
+    # LoopGen runs on the host as a 32-bit process: force host compiler
+    # (bypass cross GCC_PREFIX). Using -m32 makes sizeof(jobject)==4,
+    # sizeof(OopDesc)==4, matching the 32-bit ARM target. This eliminates
+    # ALL cross-generator size/offset mismatches at the source level.
+    # g++-11 no longer exists on this system; g++-13 -B/usr/bin is the
+    # working 32-bit combo (B forces host binutils over cross tools).
+    FORCE_GCC = /usr/bin/g++-13 -B/usr/bin -m32
+    GNU_TOOLS_DIR =
+    # Ensure host g++ uses host binutils (as/ld), not Vita SDK cross tools
+    CPP_DEF_FLAGS += -B/usr/bin -m32
+    export MSW_FIRST_FOR_DOUBLE := true
+    export MSW_FIRST_FOR_DOUBLE__BY := vita_arm.cfg
+    CPP_DEF_FLAGS += -DARM -DCROSS_GENERATOR=1
+    # LoopGen runs on host: strip ARM-only flags that host gcc rejects
+    CPP_DEF_FLAGS := $(filter-out -march=% -mtune=% -mfloat-abi=% -mfpu=%,$(CPP_DEF_FLAGS))
+    # LoopGen needs timer thread support for loop generation
+    CPP_DEF_FLAGS += -DSUPPORTS_TIMER_THREAD=1
+    ASM_FLAGS     := $(filter-out -march=% -mfloat-abi=% -mfpu=%,$(ASM_FLAGS)) --32
+    # OS_linux.cpp needs _GNU_SOURCE for SA_SIGINFO/sa_sigaction on modern glibc
+    CPP_DEF_FLAGS += -D_GNU_SOURCE
+endif
+
+# --- RomGen (runs on HOST) ---
+ifeq ($(IsRomGen),true)
+    os_family = linux
+    arch      = c
+    compiler  = gcc
+    # RomGen runs on the host as a 32-bit process: force host compiler
+    # (bypass cross GCC_PREFIX). Using -m32 makes sizeof(jobject)==4,
+    # sizeof(OopDesc)==4, matching the 32-bit ARM target. This eliminates
+    # ALL cross-generator size/offset mismatches at the source level.
+    # g++-11 no longer exists on this system; g++-13 -B/usr/bin is the
+    # working 32-bit combo (B forces host binutils over cross tools).
+    FORCE_GCC = /usr/bin/g++-13 -B/usr/bin -m32
+    GNU_TOOLS_DIR =
+    # Ensure host g++ uses host binutils (as/ld), not Vita SDK cross tools
+    CPP_DEF_FLAGS += -B/usr/bin -m32
+    export MSW_FIRST_FOR_DOUBLE := false
+    export MSW_FIRST_FOR_DOUBLE__BY := vita_arm.cfg
+    export ENABLE_C_INTERPRETER := true
+    export ENABLE_C_INTERPRETER__BY := vita_arm.cfg
+    export ENABLE_INTERPRETER_GENERATOR := false
+    export ENABLE_INTERPRETER_GENERATOR__BY := vita_arm.cfg
+    export TARGET_MSW_FIRST_FOR_DOUBLE := true
+    export TARGET_MSW_FIRST_FOR_DOUBLE__BY := vita_arm.cfg
+    export TARGET_MSW_FIRST_FOR_LONG := false
+    export TARGET_MSW_FIRST_FOR_LONG__BY := vita_arm.cfg
+    # Set carch=arm so GP_TABLE_OBJ = Interpreter_arm.o. The loop generator
+    # emits Interpreter_arm.s as x86 GNU assembly laying out the GP table
+    # (including the full JVMFastGlobals struct), which is then assembled by
+    # the HOST assembler (/usr/bin/as via FORCE_GCC), not the cross tools.
+    # Without carch, GPSkeleton.o is used instead and it defines
+    # jvm_fast_globals as a 4-byte int (because _Oop.cpp.incl is empty under
+    # -sourceMergerLimit), corrupting heap fast globals (e.g. _heap_limit).
+    carch = arm
+    iarch = c
+    CPP_DEF_FLAGS += -DARM -DCROSS_GENERATOR=1
+    # RomGen runs on host: strip ARM-only flags that host gcc rejects
+    CPP_DEF_FLAGS := $(filter-out -march=% -mtune=% -mfloat-abi=% -mfpu=%,$(CPP_DEF_FLAGS))
+    ASM_FLAGS     := $(filter-out -march=% -mfloat-abi=% -mfpu=%,$(ASM_FLAGS)) --32
+    # OS_linux.cpp needs _GNU_SOURCE for SA_SIGINFO/sa_sigaction on modern glibc
+    CPP_DEF_FLAGS += -D_GNU_SOURCE
+    # Match target ENABLE_* flags so generated code (Interpreter_arm.s,
+    # OopMaps.cpp, ROMImage) references the same symbols as the target VM
+    export ENABLE_ISOLATES := true
+    export ENABLE_JAVA_DEBUGGER := true    # Match target ENABLE_* flags so generated code (Interpreter_arm.s,
+    # OopMaps.cpp, ROMImage) references the same symbols as the target VM
+    export ENABLE_ISOLATES := true
+    export ENABLE_JAVA_DEBUGGER := true
+endif
+
+# --- Target (runs on VITA) ---
+ifeq ($(IsTarget),true)
+    os_family = vita
+    arch      = arm
+    compiler  = gcc
+
+    # Use UnixPlatform for makeDeps (same as linux, since vita is unix-like)
+    MakeDepsMain_vita = UnixPlatform
+    # makedep is invoked with cwd = $(GEN_DIR), so -gendir must be "." (not
+    # the make-level $(GEN_DIR) value "../generated") and -workspace must be the
+    # repository root. If -gendir points outside cwd, vpath resolution falls
+    # back to a minimal mode that only includes a handful of platform cpp
+    # files, so the resulting Obj_Files is missing the bulk of the VM sources
+    # (e.g. IsolateNatives, MethodTrap, sources from #if ENABLE_ISOLATES,
+    # #if ENABLE_JAVA_DEBUGGER blocks in includeDB).
+    MakeDepsOpts_vita = -gendir . -workspace $(WorkSpace) -resolveVpath true
+
+    # Enable ROM usage (loads system classes from ROMImage.o, embedded in VPK)
+    # This eliminates the need for midp_system.jar on filesystem.
+    # NOTE: ENABLE_ROM_GENERATOR must be false for the target VM build.
+    # It is only true for romgen (forced by jvm.make via 'override'). When
+    # ENABLE_ROM_GENERATOR is true in the target, USE_SOURCE_IMAGE_GENERATOR
+    # becomes 1, which pulls SourceObjectWriter.cpp into the target build.
+    # SourceObjectWriter.cpp references jvm_api_entries, but NativesTable.cpp
+    # guards jvm_api_entries with #if !defined(ROMIZING) || !defined(PRODUCT),
+    # so in a ROMIZING+PRODUCT build the symbol is absent and linking fails.
+    export ENABLE_ROM_GENERATOR := false
+    export ENABLE_ROM_GENERATOR__BY := vita_arm.cfg
+    export ROMIZING := true
+    export USE_ROM := true
+
+    # Disable Interpreter generator (ROM does not need it)
+    ifndef ENABLE_INTERPRETER_GENERATOR
+    export ENABLE_INTERPRETER_GENERATOR := false
+    export ENABLE_INTERPRETER_GENERATOR__BY := vita_arm.cfg
+    endif
+
+    # --- phoneME Feature enables ---
+    # makedep reads ENABLE_* from environment (see Main.java:getEnableFlags)
+    # and uses them to gate #if ENABLE_* blocks in includeDB. Without these
+    # exports, the corresponding .cpp files are dropped from Obj_Files, which
+    # causes link errors for symbols referenced by the auto-generated
+    # NativesTable.cpp (e.g. Isolate_*, DebuggerInvoke_*, MethodTrap_setTrap).
+    # These flags must be exported (not just set) so they propagate to the
+    # makedep child process.
+    ifndef ENABLE_JAVA_DEBUGGER
+    export ENABLE_JAVA_DEBUGGER := true
+    export ENABLE_JAVA_DEBUGGER__BY := vita_arm.cfg
+    endif
+    # NOTE: ENABLE_REFLECTION must stay false on Vita because the
+    # reflection subsystem (FieldEnumerator, FieldObj, MethodObj,
+    # ConstructorObj, ParsedTypeSymbol) is not present in this
+    # phoneme_feature source tree - enabling it would make makedep
+    # require files that do not exist.
+    ifndef ENABLE_ISOLATES
+    export ENABLE_ISOLATES := true
+    export ENABLE_ISOLATES__BY := vita_arm.cfg
+    endif
+
+    export MSW_FIRST_FOR_DOUBLE := true
+    export MSW_FIRST_FOR_DOUBLE__BY := vita_arm.cfg
+
+    CPP_DEF_FLAGS += -DARM -DVITA -D__PSP2__
+
+    # ROM image contains hex constants > INT_MAX in int arrays; suppress
+    # C++11 narrowing conversion errors for the generated ROMImage_*.cpp
+    # Also use -fpermissive for int<->pointer conversions in ROM image
+    CPP_DEF_FLAGS += -Wno-narrowing -fpermissive
+
+    # ARM architecture flags
+    # Use ARM mode (not Thumb) because phoneME's Assembler_arm.hpp emits
+    # ARM-mode SWI instructions with 24-bit immediates (e.g. swi 0x9f0001)
+    # which are illegal in Thumb mode (only 8-bit immediate allowed).
+    CPP_DEF_FLAGS += -marm -march=armv7-a -mtune=cortex-a9 -mfloat-abi=hard -mfpu=vfpv3
+    ASM_FLAGS += -march=armv7-a -mfloat-abi=hard -mfpu=vfpv3
+
+    # Vita-specific: no mmap, no fork, no signals for VM exceptions
+    # Vita supports pthreads, so we can use timer thread
+    CPP_DEF_FLAGS += -DSUPPORTS_MEMORY_MAPPED_FILES=0 \
+	             -DSUPPORTS_ADJUSTABLE_MEMORY_CHUNK=0 \
+	             -DSUPPORTS_TIMER_THREAD=1 -DSUPPORTS_TIMER_INTERRUPT=0 \
+	             -DUSE_VM_EXCEPTIONS=0
+
+    # Enable BSD socket support (Vita's newlib provides BSD socket API)
+    CPP_DEF_FLAGS += -DUSE_BSD_SOCKET=1
+
+    # Link flags for Vita (no vitasdk.specs needed, use crt0.o directly)
+    LINK_FLAGS += -nostartfiles \
+	          $(VITASDK)/arm-vita-eabi/lib/crt0.o \
+          $(VITASDK)/lib/gcc/arm-vita-eabi/10.3.0/crtbegin.o \
+          $(VITASDK)/lib/gcc/arm-vita-eabi/10.3.0/crtend.o \
+          $(VITASDK)/lib/gcc/arm-vita-eabi/10.3.0/crti.o \
+          $(VITASDK)/lib/gcc/arm-vita-eabi/10.3.0/crtn.o \
+	          -Wl,-q -Wl,--gc-sections \
+	          -Wl,-z,nocopyreloc -Wl,-z,max-page-size=0x1000
+
+# Libraries (names match actual files in vitasdk)
+    LINK_FLAGS += -lvita2d -lSceDisplay_stub -lSceCtrl_stub -lSceGxm_stub \
+          -lSceAudio_stub -lSceKernelThreadMgr_stub -lSceSysmodule_stub \
+          -lSceCommonDialog_stub -lSceAppMgr_stub -lSceIofilemgr_stub \
+          -lScePgf_stub -lSceJpeg_stub -lSceNet_stub \
+	          -lSceNetCtl_stub -lSceHttp_stub -lSceSsl_stub
+
+    # Disable thumb mode for now (simplify porting)
+    ifndef ENABLE_THUMB_VM
+    export ENABLE_THUMB_VM := false
+    endif
+    ifndef ENABLE_THUMB_COMPILER
+    export ENABLE_THUMB_COMPILER := false
+    endif
+
+    # Enable JIT by default (can be overridden)
+    ifndef ENABLE_JIT
+    export ENABLE_JIT := true
+    endif
+
+    # Memory settings for Vita (limited RAM)
+    ifndef JAVA_HEAP_SIZE
+    export JAVA_HEAP_SIZE := 64  # MB
+    endif
+    ifndef JAVA_STACK_SIZE
+    export JAVA_STACK_SIZE := 256  # KB
+    endif
+endif
+
+# --- Source Merging ---
+ifndef MERGE_SOURCE_FILES
+MERGE_SOURCE_FILES = true
+endif
+
+# NOTE: ENABLE_ISOLATES and ENABLE_JAVA_DEBUGGER must be set OUTSIDE of
+# IsTarget/IsLoopGen/IsRomGen blocks so they are visible to ALL build
+# stages (root.make's print_config runs before cfg is included, so
+# these values appear as empty in print_config output, which is normal).
+ifndef ENABLE_ISOLATES
+export ENABLE_ISOLATES := true
+endif
+
+ifndef ENABLE_JAVA_DEBUGGER
+export ENABLE_JAVA_DEBUGGER := true
+endif
+
+ifndef SOURCE_MERGER_SIZE
+SOURCE_MERGER_SIZE = 35
+endif
+
+export BUILD_ANI_LIB := true
+
+# Add compilation rule for Vita OS layer files
+# This must come after the os_family is set to 'vita'
+ifeq ($(IsTarget),true)
+    %$(OBJ_SUFFIX): $(WorkSpace)/src/vm/os/vita/%.cpp
+	$(A)echo " ... $(notdir $<) (Vita)"
+	$(A)$(CPP) $(CPP_OPT_FLAGS) $(CPP_FLAGS) -c $< -o $@
+endif
+
+# --- Host generator stages: strip ARM-only flags (must be last, after all +=) ---
+ifneq ($(IsLoopGen)$(IsRomGen),)
+    CPP_DEF_FLAGS := $(filter-out -march=% -mtune=% -mfloat-abi=% -mfpu=%,$(CPP_DEF_FLAGS))
+    ASM_FLAGS     := $(filter-out -march=% -mfloat-abi=% -mfpu=%,$(ASM_FLAGS))
+endif
+
+# --- Host generator stages: override flags that conflict with host compiler ---
+ifneq ($(IsTarget),true)
+    # Target section sets SUPPORTS_TIMER_THREAD=0, but loopgen/romgen need it=1
+    CPP_DEF_FLAGS := $(filter-out -DSUPPORTS_TIMER_THREAD=%,$(CPP_DEF_FLAGS))
+    CPP_DEF_FLAGS += -DSUPPORTS_TIMER_THREAD=1
+    # Strip ARM-only flags that host gcc rejects
+    CPP_DEF_FLAGS := $(filter-out -march=% -mtune=% -mfloat-abi=% -mfpu=%,$(CPP_DEF_FLAGS))
+    ASM_FLAGS     := $(filter-out -march=% -mfloat-abi=% -mfpu=%,$(ASM_FLAGS))
+endif
