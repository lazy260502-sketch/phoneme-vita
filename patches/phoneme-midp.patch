+    public RSAPublicKey(byte[] modulus, byte[] exponent){
+        key = new com.sun.midp.crypto.RSAPublicKey(modulus, exponent);        
+    }
+
+    public RSAPublicKey(byte[] modulus, int modOffset, int modLen,
+                    byte[] exponent, int expOffset, int expLen) {
+        key = new com.sun.midp.crypto.RSAPublicKey(modulus,
+                    modOffset, modLen, exponent, expOffset, expLen);        
+    }
+
+    public com.sun.midp.crypto.Key getKey() {
+        return key;
+    }
+}
