+static void lifecycle_poll(void) {
+    SceAppMgrSystemEvent ev;
+
+    if (!sys_events_initialized) {
+        /* First call: register nothing, just mark ready. */
+        sys_events_initialized = 1;
+    }
+
+    while (sceAppMgrReceiveSystemEvent(&ev) == 0) {
+        if (ev.systemEvent == SCE_APPMGR_SYSTEMEVENT_ON_RESUME) {
+            midp_resume();
+        } else {
+            /* Any other system event (store purchase notice etc) also
+             * implies we lost focus briefly; suspend is the safe move. */
+            midp_suspend();
+        }
+    }
 }
 
