diff --git a/j2me/vita-port/midlets/NetTest.java b/j2me/vita-port/midlets/NetTest.java
new file mode 100644
index 0000000..0ef1ab3
--- /dev/null
+++ b/j2me/vita-port/midlets/NetTest.java
@@ -0,0 +1,106 @@
+import java.io.*;
+import javax.microedition.io.*;
+import javax.microedition.lcdui.*;
+import javax.microedition.midlet.*;
+
+/**
+ * Network smoke test MIDlet. Performs an HttpConnection GET against a
+ * configurable URL (default http://example.com/) on a worker thread and
+ * renders the HTTP status line plus the first bytes of the body on a Form.
+ *
+ * Exercises the full stack: pure-Java HTTP -> socket:// Protocol ->
+ * pcsl_socket_* (vita_net.c) -> newlib BSD wrappers -> sceNet.
+ */
+public class NetTest extends MIDlet implements CommandListener, Runnable {
+    private Display display;
+    private Form form;
+    private StringItem status;
+    private Command exitCommand;
+    private Command goCommand;
+    private volatile boolean running;
+
+    public NetTest() {
+        display = Display.getDisplay(this);
+        exitCommand = new Command("Exit", Command.EXIT, 0);
+        goCommand = new Command("Go", Command.OK, 0);
+        form = new Form("NetTest");
+        status = new StringItem("Status:", "ready");
+        form.append(status);
+        form.addCommand(goCommand);
+        form.addCommand(exitCommand);
+        form.setCommandListener(this);
+    }
+
+    public void startApp() {
+        display.setCurrent(form);
+        if (!running) {
+            running = true;
+            new Thread(this).start();
+        }
+    }
+
+    public void pauseApp() {}
+
+    public void destroyApp(boolean unconditional) {
+        running = false;
+    }
+
+    public void commandAction(Command c, Displayable d) {
+        if (c == exitCommand) {
+            destroyApp(true);
+            notifyDestroyed();
+        } else if (c == goCommand) {
+            new Thread(this).start();
+        }
+    }
+
+    public void run() {
+        try {
+            doFetch("http://example.com/");
+        } catch (Throwable t) {
+            setStatus("EXC", t.toString());
+        }
+    }
+
+    private void doFetch(String url) {
+        HttpConnection hc = null;
+        InputStream is = null;
+        try {
+            setStatus("connecting", url);
+            hc = (HttpConnection)Connector.open(url);
+            hc.setRequestMethod(HttpConnection.GET);
+            int rc = hc.getResponseCode();
+            String s = "HTTP " + rc + " " + hc.getResponseMessage()
+                    + "\nlen=" + hc.getLength();
+            setStatus("response", s);
+
+            is = hc.openInputStream();
+            byte[] buf = new byte[256];
+            int n = is.read(buf);
+            if (n > 0) {
+                StringBuffer sb = new StringBuffer();
+                for (int i = 0; i < n && i < 128; i++) {
+                    char ch = (char)(buf[i] & 0xff);
+                    if (ch >= 32 && ch < 127) {
+                        sb.append(ch);
+                    } else if (ch == '\n') {
+                        sb.append('\n');
+                    }
+                }
+                setStatus("body", sb.toString());
+            } else {
+                setStatus("body", "<empty read, n=" + n + ">");
+            }
+        } catch (IOException e) {
+            setStatus("IOEXC", e.toString());
+        } finally {
+            try { if (is != null) is.close(); } catch (IOException e) {}
+            try { if (hc != null) hc.close(); } catch (IOException e) {}
+        }
+    }
+
+    private void setStatus(String tag, String msg) {
+        status.setText(tag + ": " + msg);
+        form.setTitle(tag);
+    }
+}
diff --git a/j2me/vita-port/midlets/ProbeMIDlet.java b/j2me/vita-port/midlets/ProbeMIDlet.java
new file mode 100644
index 0000000..390af73
--- /dev/null
+++ b/j2me/vita-port/midlets/ProbeMIDlet.java
@@ -0,0 +1,182 @@
+import javax.microedition.lcdui.*;
+import javax.microedition.midlet.*;
+import javax.microedition.rms.*;
+import javax.microedition.media.*;
+import java.io.*;
+
+/**
+ * Subsystem compatibility probe. Tests each subsystem old J2ME games use
+ * and prints a PASS/FAIL line per item to System.out (lands in
+ * midp_stdout.log on Vita). Finishes with "PROBE DONE".
+ */
+public class ProbeMIDlet extends MIDlet implements CommandListener {
+    private Display display;
+    private Form form;
+
+    public ProbeMIDlet() {
+        display = Display.getDisplay(this);
+        form = new Form("Probe");
+        form.addCommand(new Command("Exit", Command.EXIT, 0));
+        form.setCommandListener(this);
+    }
+
+    private void log(String s) {
+        System.out.println("[PROBE] " + s);
+        form.append(s + "\n");
+    }
+
+    public void startApp() {
+        System.out.println("[PROBE] === START ===");
+
+        try {
+            log("props: platform=" + System.getProperty("microedition.platform")
+                + " encoding=" + System.getProperty("microedition.encoding"));
+        } catch (Throwable t) {
+            log("props FAIL: " + t);
+        }
+
+        /* Canvas + Graphics primitives */
+        try {
+            Canvas c = new Canvas() {
+                public void paint(Graphics g) {
+                    g.setColor(0xFF8040);
+                    g.fillRect(0, 0, getWidth(), getHeight());
+                }
+            };
+            log("canvas: w=" + c.getWidth() + " h=" + c.getHeight());
+        } catch (Throwable t) {
+            log("canvas FAIL: " + t);
+        }
+
+        /* GameCanvas */
+        try {
+            Class.forName("javax.microedition.lcdui.game.GameCanvas");
+            log("game package: present");
+        } catch (Throwable t) {
+            log("game package FAIL: " + t);
+        }
+
+        /* Offscreen image + drawImage (blit) */
+        try {
+            Image img = Image.createImage(16, 16);
+            log("offscreen image: ok");
+        } catch (Throwable t) {
+            log("offscreen image FAIL: " + t);
+        }
+
+        /* PNG resource decode: put a tiny png in the jar to test */
+        try {
+            InputStream in = getClass().getResourceAsStream("/probe.png");
+            if (in == null) {
+                log("png probe: /probe.png not in jar (skipped)");
+            } else {
+                Image img = Image.createImage(in);
+                in.close();
+                log("png decode: ok " + img.getWidth() + "x" + img.getHeight());
+            }
+        } catch (Throwable t) {
+            log("png decode FAIL: " + t);
+        }
+
+        /* RMS */
+        try {
+            RecordStore rs = RecordStore.openRecordStore("probe", true);
+            byte[] data = "hello".getBytes();
+            rs.addRecord(data, 0, data.length);
+            int n = rs.getNumRecords();
+            rs.closeRecordStore();
+            RecordStore.deleteRecordStore("probe");
+            log("rms: ok, records=" + n);
+        } catch (Throwable t) {
+            log("rms FAIL: " + t);
+        }
+
+        /* Chameleon skin resource (what Form/List rendering needs) */
+        try {
+            InputStream in = getClass().getResourceAsStream(
+                "/skin/softbtn.image_bg0.png");
+            if (in == null) {
+                log("skin resource: NOT FOUND in jar!");
+            } else {
+                Image img = Image.createImage(in);
+                in.close();
+                log("skin resource: ok " + img.getWidth() + "x" +
+                    img.getHeight());
+            }
+        } catch (Throwable t) {
+            log("skin resource FAIL: " + t);
+        }
+
+        /* MMAPI tone player - the usual suspect for CLDC-1.0 games */
+        try {
+            Player p = Manager.createPlayer(Manager.TONE_DEVICE_LOCATOR);
+            p.start();
+            p.close();
+            log("mmapi tone: ok");
+        } catch (Throwable t) {
+            log("mmapi tone FAIL: " + t.getClass().getName() + ": " +
+                t.getMessage());
+        }
+
+        /* MMAPI wav from stream */
+        try {
+            InputStream in = getClass().getResourceAsStream("/probe.wav");
+            if (in == null) {
+                log("mmapi wav: /probe.wav not in jar (skipped)");
+            } else {
+                Player p = Manager.createPlayer(in, "audio/x-wav");
+                p.start();
+                p.close();
+                log("mmapi wav: ok");
+            }
+        } catch (Throwable t) {
+            log("mmapi wav FAIL: " + t.getClass().getName() + ": " +
+                t.getMessage());
+        }
+
+        /* Threads */
+        try {
+            final Object lock = new Object();
+            Thread t = new Thread() {
+                public void run() {
+                    synchronized (lock) { lock.notifyAll(); }
+                }
+            };
+            synchronized (lock) {
+                t.start();
+                lock.wait(1000);
+            }
+            log("threads: ok");
+        } catch (Throwable t) {
+            log("threads FAIL: " + t);
+        }
+
+        System.out.println("[PROBE] === DONE (no hang above this line) ===");
+
+        /* Final check: a skin-independent pure Canvas. If THIS shows,
+         * rendering + flush are fine and any Form problem is skin/UI
+         * specific. */
+        display.setCurrent(new Canvas() {
+            public void paint(Graphics g) {
+                g.setColor(0xC00000);
+                g.fillRect(0, 0, getWidth(), getHeight());
+                g.setColor(0xFFFFFF);
+                g.drawString("CANVAS OK " + getWidth() + "x" +
+                             getHeight(), 10, 20,
+                             Graphics.TOP | Graphics.LEFT);
+                g.setColor(0x00FF00);
+                g.fillRect(10, 60, getWidth() - 20, 40);
+            }
+        });
+        System.out.println("[PROBE] red canvas shown");
+    }
+
+    public void pauseApp() {}
+
+    public void destroyApp(boolean unconditional) {}
+
+    public void commandAction(Command c, Displayable d) {
+        destroyApp(true);
+        notifyDestroyed();
+    }
+}
diff --git a/j2me/vita-port/midlets/RmsTest.java b/j2me/vita-port/midlets/RmsTest.java
new file mode 100644
index 0000000..e55e3fd
--- /dev/null
+++ b/j2me/vita-port/midlets/RmsTest.java
@@ -0,0 +1,121 @@
+import java.io.*;
+import javax.microedition.lcdui.*;
+import javax.microedition.midlet.*;
+import javax.microedition.rms.*;
+
+/**
+ * RMS persistence smoke test. On each launch: opens record store
+ * "vita_rms_test", reads a launch counter from record 1, increments it,
+ * writes it back, and displays the counter plus store info.
+ *
+ * First run shows "launch #1". Any later run showing #2 or higher proves
+ * the full persistence chain: Java RecordStore -> RMS native (libobj.a)
+ * -> midp_file_cache -> storage_open -> pcsl_file_* (vita_pcsl.c) ->
+ * sceIo on ux0:.
+ */
+public class RmsTest extends MIDlet implements CommandListener {
+    private Display display;
+    private Form form;
+    private StringItem result;
+    private Command exitCommand;
+    private Command wipeCommand;
+
+    private static final String STORE_NAME = "vita_rms_test";
+
+    public RmsTest() {
+        display = Display.getDisplay(this);
+        exitCommand = new Command("Exit", Command.EXIT, 0);
+        wipeCommand = new Command("Wipe", Command.SCREEN, 1);
+        form = new Form("RmsTest");
+        result = new StringItem("Result:", "running...");
+        form.append(result);
+        form.addCommand(exitCommand);
+        form.addCommand(wipeCommand);
+        form.setCommandListener(this);
+    }
+
+    public void startApp() {
+        display.setCurrent(form);
+        runTest();
+    }
+
+    public void pauseApp() {}
+
+    public void destroyApp(boolean unconditional) {}
+
+    public void commandAction(Command c, Displayable d) {
+        if (c == exitCommand) {
+            destroyApp(true);
+            notifyDestroyed();
+        } else if (c == wipeCommand) {
+            wipe();
+        }
+    }
+
+    private void runTest() {
+        RecordStore rs = null;
+        try {
+            rs = RecordStore.openRecordStore(STORE_NAME, true);
+
+            int launches = readCounter(rs) + 1;
+            writeCounter(rs, launches);
+
+            StringBuffer sb = new StringBuffer();
+            sb.append("launch #").append(launches);
+            sb.append(launches > 1 ? "  [PERSIST OK]"
+                                   : "  [first run]");
+            sb.append("\nrecords: ").append(rs.getNumRecords());
+            sb.append("\nsize: ").append(rs.getSize()).append(" bytes");
+            sb.append("\nnext avail: ")
+              .append(rs.getSizeAvailable()).append(" bytes");
+            result.setText(sb.toString());
+        } catch (Throwable t) {
+            result.setText("FAILED: " + t.toString());
+        } finally {
+            if (rs != null) {
+                try { rs.closeRecordStore(); } catch (RecordStoreException e) {}
+            }
+        }
+    }
+
+    /** Reads the counter from record 1; missing store/corrupt -> 0. */
+    private int readCounter(RecordStore rs) {
+        try {
+            if (rs.getNumRecords() < 1) {
+                return 0;
+            }
+            byte[] data = rs.getRecord(1);
+            if (data == null || data.length < 4) {
+                return 0;
+            }
+            return ((data[0] & 0xFF) << 24) | ((data[1] & 0xFF) << 16)
+                 | ((data[2] & 0xFF) << 8)  |  (data[3] & 0xFF);
+        } catch (RecordStoreException e) {
+            return 0;
+        }
+    }
+
+    /** Writes the counter as record 1 (add or set). */
+    private void writeCounter(RecordStore rs, int value)
+            throws RecordStoreException {
+        byte[] data = new byte[] {
+            (byte)(value >> 24), (byte)(value >> 16),
+            (byte)(value >> 8),  (byte) value
+        };
+        if (rs.getNumRecords() < 1) {
+            rs.addRecord(data, 0, data.length);
+        } else {
+            rs.setRecord(1, data, 0, data.length);
+        }
+    }
+
+    /** Wipes the store so the test can restart from #1. */
+    private void wipe() {
+        try {
+            RecordStore.deleteRecordStore(STORE_NAME);
+            result.setText("store deleted; relaunch to restart");
+        } catch (RecordStoreException e) {
+            result.setText("wipe failed: " + e.toString());
+        }
+    }
+}
