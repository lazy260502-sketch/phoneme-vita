+    
+    SceIoStat stat;
+    if (sceIoGetstat(app0_path, &stat) >= 0) {
+        return (long)stat.st_size;
+    }
+    
+    if (sceIoGetstat(path_utf8, &stat) >= 0) {
+        return (long)stat.st_size;
+    }
+    
+    return -1;
+}
