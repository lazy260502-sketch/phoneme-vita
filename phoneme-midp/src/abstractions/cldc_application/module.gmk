# Minimal abstractions stub: only the 4 classes actually referenced by jsr135.
# Replaces the original abstractions/cldc_application/module.gmk.
#

JSROP_ABSTRACTIONS_DIR=$(ABSTRACTIONS_DIR)

# No native source files needed
ABSTRACTIONS_NATIVES +=

# Link libraries
JSROP_ABSTRACTIONS_LINKLIBS =

# Include paths (share/ and native/ are symlinked from original abstractions)
JSROP_ABSTRACTIONS_INCLUDES = \
    -I$(JSROP_ABSTRACTIONS_DIR)/share/include \
    -I$(JSROP_ABSTRACTIONS_DIR)/cldc_application/native/include \
    -I$(JSROP_ABSTRACTIONS_DIR)/cldc_application/native/$(TARGET_PLATFORM)

# Source dir
JSROP_ABSTRACTIONS_JAVASRCDIRS = \
        $(JSROP_ABSTRACTIONS_DIR)/cldc_application/classes

# All abstractions classes (copied from phoneme_source, with custom ResourceConstants)
ABSTRACTIONS_CLASSES := $(sort \
    $(filter-out %/ResourceConstants.java, \
        $(shell find $(JSROP_ABSTRACTIONS_JAVASRCDIRS) -name "*.java" 2>/dev/null)) \
    $(JSROP_ABSTRACTIONS_JAVASRCDIRS)/com/sun/j2me/i18n/ResourceConstants.java)

JTWI_NATIVE_FILES  += $(ABSTRACTIONS_NATIVES)
EXTRA_INCLUDES     += $(JSROP_ABSTRACTIONS_INCLUDES)

$(MIDP_CLASSES_ZIP):: $(ABSTRACTIONS_CLASSES)
	$(appendjavafiles)

abstractions_source_bundle::
