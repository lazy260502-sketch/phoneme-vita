+/* ---- Key repeat: PRESSED -> (REPEATED n times) -> RELEASED ----
+ * MIDP games poll for repeated fire/steering; without repeat, holding a
+ * direction fires the Canvas.keyRepeated stream games depend on. */
+#define REPEAT_DELAY_MS  400
+#define REPEAT_PERIOD_MS 60
+
+typedef struct {
+    int key;            /* KEYMAP_KEY_* currently held, 0 = none */
+    long long holdMs;   /* accumulates while held */
+    int sentRepeat;     /* first REPEATED already scheduled */
+} RepeatState;
+
+static RepeatState repeat_state = {0, 0, 0};
+
+static long long now_ms(void) {
+    return (long long)(sceKernelGetSystemTimeWide() / 1000);
+}
+
+static void repeat_note_press(int key) {
+    repeat_state.key = key;
+    repeat_state.holdMs = now_ms();
+    repeat_state.sentRepeat = 0;
+}
+
+static void repeat_note_release(int key) {
+    if (repeat_state.key == key) {
+        repeat_state.key = 0;
+    }
+}
+
+/* Called every poll; emits REPEATED events while a key stays held. */
+static void repeat_tick(void) {
+    if (repeat_state.key == 0) {
+        return;
+    }
+    long long held = now_ms() - repeat_state.holdMs;
+    if (held < REPEAT_DELAY_MS) {
+        return;
+    }
+    /* After the delay, emit once per REPEAT_PERIOD_MS. */
+    long long over = held - REPEAT_DELAY_MS;
+    long long want = 1 + over / REPEAT_PERIOD_MS; /* repeats due so far */
+    while (repeat_state.sentRepeat < (int)want) {
+        repeat_state.sentRepeat++;
+        emit_key_event(repeat_state.key, KEYMAP_STATE_REPEATED);
+    }
+}
