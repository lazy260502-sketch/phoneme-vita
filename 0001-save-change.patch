+/*
+ * vita_menu.c - Native game-selection menu for vita-port
+ *
+ * Runs before the JVM starts: lists installed games
+ * (ux0:/data/J2ME00001/games/<name>/game.jar), installs jars dropped into
+ * ux0:/data/J2ME00001/inbox/, lets the user launch/uninstall games and
+ * toggle the portrait/landscape orientation per game (game.cfg).
+ *
+ * Rendering: hand-drawn 32bpp framebuffer + FreeType (bundled CJK TTF),
+ * synced with sceDisplayWaitVblankStart at 60 Hz. We deliberately avoid
+ * vita2d: its GXM display queue either crashes on teardown or keeps
+ * owning the display after the menu, blanking every later MIDlet screen.
+ * With raw sceDisplaySetFrameBuf the JVM display path takes over cleanly.
+ *
+ * MIDlet class names are read from the jar's META-INF/MANIFEST.MF using
+ * phoneME's own jar API (midpOpenJar/midpGetJarEntry from libobj.a).
+ *
+ * Keys: UP/DOWN select (auto-repeat), CROSS open dialog / launch,
+ *       CIRCLE back, START install inbox, SELECT rescan. Touch works.
+ *
+ * Known limitation: all games share one internal-suite RMS space.
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <psp2/ctrl.h>
+#include <psp2/display.h>
+#include <psp2/touch.h>
+#include <psp2/io/fcntl.h>
+#include <psp2/io/stat.h>
+#include <psp2/io/dirent.h>
+#include <psp2/kernel/threadmgr.h>
+
+#include <ft2build.h>
+#include FT_FREETYPE_H
+
+#include <pcsl_string.h>
+#include <midpJar.h>
+#include <midpMalloc.h>
+
+#include "vita_menu.h"
+
+#define GAMES_DIR "ux0:/data/J2ME00001/games"
+#define INBOX_DIR "ux0:/data/J2ME00001/inbox"
+#define CFG_NAME  "game.cfg"
+#define JAR_NAME  "game.jar"
+
+#define MAX_GAMES 64
+#define FB_W 960
+#define FB_H 544
+
+#define C_BG     0xFF101820u
+#define C_FG     0xFFF0F0F0u
+#define C_SEL    0xFFA05030u
+#define C_TITLE  0xFF40B0E0u
+#define C_HINT   0xFF8C8478u
+#define C_WARN   0xFF5050E0u
+#define C_DIRT   0xFF78BE78u
+#define C_PANEL  0xFF34404Cu
+
+static uint32_t *menu_fb = NULL;
+
+/* ------------------------------------------------------------------ */
+/* Framebuffer primitives                                             */
+/* ------------------------------------------------------------------ */
+
+static void fill_rect(int x, int y, int w, int h, uint32_t color) {
+    int row, col;
+    if (menu_fb == NULL) return;
+    for (row = 0; row < h; row++) {
+        int py = y + row;
+        if (py < 0 || py >= FB_H) continue;
+        for (col = 0; col < w; col++) {
+            int px = x + col;
+            if (px >= 0 && px < FB_W) {
+                menu_fb[py * FB_W + px] = color;
+            }
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Text: FreeType over the bundled CJK TTF (UTF-8 input)              */
+/* ------------------------------------------------------------------ */
+
+static FT_Library ft_lib;
+static FT_Face ft_face;
+static int ft_ready = 0;
+static int ft_last_px = -1;
+static unsigned char *ft_font_buf = NULL; /* kept alive for Memory_Face */
+
+static unsigned long utf8_next(const char **p) {
+    const unsigned char *s = (const unsigned char *)*p;
+    unsigned long cp;
+    if (s[0] < 0x80) {
+        cp = s[0];
+        *p += 1;
+    } else if ((s[0] & 0xE0) == 0xC0) {
+        cp = ((s[0] & 0x1F) << 6) | (s[1] & 0x3F);
+        *p += 2;
+    } else if ((s[0] & 0xF0) == 0xE0) {
+        cp = ((s[0] & 0x0F) << 12) | ((s[1] & 0x3F) << 6) | (s[2] & 0x3F);
+        *p += 3;
+    } else {
+        cp = ((s[0] & 0x07) << 18) | ((s[1] & 0x3F) << 12) |
+             ((s[2] & 0x3F) << 6) | (s[3] & 0x3F);
+        *p += 4;
+    }
+    return cp;
+}
+
+static int ft_init(void) {
+    SceUID f;
+    unsigned int size;
+    unsigned char *buf;
+
+    if (FT_Init_FreeType(&ft_lib) != 0) {
+        return -1;
+    }
+    f = sceIoOpen("app0:/data/J2ME00001/font.ttf", SCE_O_RDONLY, 0);
+    if (f < 0) {
+        return -1;
+    }
+    size = sceIoLseek(f, 0, SCE_SEEK_END);
+    sceIoLseek(f, 0, SCE_SEEK_SET);
+    buf = (unsigned char *)malloc(size);
+    if (buf == NULL) {
+        sceIoClose(f);
+        return -1;
+    }
+    if (sceIoRead(f, buf, size) != (int)size) {
+        free(buf);
+        sceIoClose(f);
+        return -1;
+    }
+    sceIoClose(f);
+    if (FT_New_Memory_Face(ft_lib, buf, size, 0, &ft_face) != 0) {
+        free(buf);
+        return -1;
+    }
+    ft_font_buf = buf; /* FT references it; freed in ft_shutdown */
+    ft_ready = 1;
+    return 0;
+}
+
+/* Release everything freetype holds (its 16MB font buffer was squeezing
+ * the 64MB newlib pool while the VM needed 32MB for the Java heap - the
+ * chameleon UI died silently on the squeeze). The menu is synchronous:
+ * after it returns the font is never needed again. */
+static void ft_shutdown(void) {
+    if (ft_ready) {
+        FT_Done_Face(ft_face);
+        FT_Done_FreeType(ft_lib);
+        ft_ready = 0;
+    }
+    if (ft_font_buf != NULL) {
+        free(ft_font_buf);
+        ft_font_buf = NULL;
+    }
+}
+
+static void ft_set_px(int px) {
+    if (px != ft_last_px) {
+        FT_Set_Pixel_Sizes(ft_face, 0, px);
+        ft_last_px = px;
+    }
+}
+
+/* Blend one rendered glyph at (dx, dy). */
+static void draw_glyph(int dx, int dy, uint32_t color) {
+    FT_GlyphSlot g = ft_face->glyph;
+    unsigned char *src = (unsigned char *)g->bitmap.buffer;
+    int rows = g->bitmap.rows;
+    int width = g->bitmap.width;
+    int ix, iy;
+    unsigned int r = color & 0xFF, g8 = (color >> 8) & 0xFF;
+    unsigned int b = (color >> 16) & 0xFF;
+
+    for (iy = 0; iy < rows; iy++) {
+        const unsigned char *line = src + iy * g->bitmap.pitch;
+        int py = dy + iy;
+        if (py < 0 || py >= FB_H) continue;
+        for (ix = 0; ix < width; ix++) {
+            unsigned int a = line[ix];
+            int pxx = dx + ix;
+            if (a == 0 || pxx < 0 || pxx >= FB_W) continue;
+            {
+                /* signed math: unsigned (dst - src) underflowed and
+                 * garbled every glyph over a darker background */
+                uint32_t *px = &menu_fb[py * FB_W + pxx];
+                int dr = (int)(*px & 0xFF), dg = (int)((*px >> 8) & 0xFF);
+                int db = (int)((*px >> 16) & 0xFF);
+                int nr = r + (((int)r - dr) * a >> 8);
+                int ng = g8 + (((int)g8 - dg) * a >> 8);
+                int nb = b + (((int)b - db) * a >> 8);
+                *px = 0xFF000000u | ((unsigned)nb << 16) |
+                      ((unsigned)ng << 8) | (unsigned)nr;
+            }
+        }
+    }
+}
+
+static int ascent_for(int px) {
+    ft_set_px(px);
+    return ft_face->size->metrics.ascender >> 6;
+}
+
+/* Draw UTF-8 text; y is the TOP of the text. Returns pen x after text. */
+static int ui_text(int x, int y, uint32_t color, int px, const char *s) {
+    const char *p = s;
+    int ascent, pen_x = x;
+    if (!ft_ready) return x;
+    ft_set_px(px);
+    ascent = ft_face->size->metrics.ascender >> 6;
+    while (*s) {
+        unsigned long cp = utf8_next(&s);
+        if (FT_Load_Char(ft_face, cp, FT_LOAD_RENDER) != 0) continue;
+        draw_glyph(pen_x + ft_face->glyph->bitmap_left,
+                   y + ascent - ft_face->glyph->bitmap_top, color);
+        pen_x += ft_face->glyph->advance.x >> 6;
+    }
+    return pen_x;
+}
+
+static int ui_textf(int x, int y, uint32_t color, int px,
+                    const char *fmt, ...) {
+    char buf[256];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    return ui_text(x, y, color, px, buf);
+}
+
+/* ------------------------------------------------------------------ */
+/* Input: edge-triggered keys with time-based repeat + touch taps     */
+/* ------------------------------------------------------------------ */
+
+static unsigned int prev_btn = 0;
+static unsigned long long first_press_us = 0;
+static unsigned long long last_repeat_us = 0;
+
+static unsigned long long now_us(void) {
+    return sceKernelGetProcessTimeWide();
+}
+
+static unsigned int poll_buttons(void) {
+    SceCtrlData pad;
+    unsigned int cur, pressed;
+    unsigned long long t;
+
+    sceCtrlPeekBufferPositive(0, &pad, 1);
+    cur = pad.buttons;
+    pressed = cur & ~prev_btn;
+    t = now_us();
+
+    if (pressed & (SCE_CTRL_UP | SCE_CTRL_DOWN)) {
+        first_press_us = t;
+        last_repeat_us = t;
+    } else if (cur & (SCE_CTRL_UP | SCE_CTRL_DOWN)) {
+        if (t - first_press_us > 300000ULL &&
+            t - last_repeat_us > 100000ULL) {
+            pressed = cur & (SCE_CTRL_UP | SCE_CTRL_DOWN);
+            last_repeat_us = t;
+        }
+    }
+    prev_btn = cur;
+    return pressed;
+}
+
+/* Returns 1 once per completed tap (press->release), screen coords. */
+static int touch_tap(int *out_x, int *out_y) {
+    static int was_down = 0;
+    static int last_x = -1, last_y = -1;
+    SceTouchData td;
+
+    *out_x = -1;
+    *out_y = -1;
+    sceTouchSetSamplingState(SCE_TOUCH_PORT_FRONT,
+                             SCE_TOUCH_SAMPLING_STATE_START);
+    if (sceTouchPeek(SCE_TOUCH_PORT_FRONT, &td, 1) < 0) {
+        was_down = 0;
+        return 0;
+    }
+    if (td.reportNum > 0) {
+        was_down = 1;
+        last_x = td.report[0].x / 2;
+        last_y = td.report[0].y / 2;
+        return 0;
+    }
+    if (was_down) {
+        was_down = 0;
+        *out_x = last_x;
+        *out_y = last_y;
+        return 1;
+    }
+    return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Game catalogue                                                     */
+/* ------------------------------------------------------------------ */
+
+typedef struct {
+    char dir[160];
+    char name[128];
+    char jar[176];
+    char cls[128];
+    int landscape;
+} GameEntry;
+
+static GameEntry games[MAX_GAMES];
+static int game_count = 0;
+
+static void make_pcsl_string(const char *utf8, pcsl_string *ps) {
+    size_t n = strlen(utf8);
+    jchar *w = (jchar *)malloc(n * sizeof(jchar));
+    size_t i;
+    for (i = 0; i < n; i++) {
+        w[i] = (jchar)(unsigned char)utf8[i];
+    }
+    ps->data = w;
+    ps->length = (jsize)n;
+    ps->flags = 0;
+}
+
+static void free_pcsl_string(pcsl_string *ps) {
+    free(ps->data);
+    ps->data = NULL;
+    ps->length = 0;
+}
+
+/* Case-insensitive META-INF/MANIFEST.MF locator (some jars built on
+ * Windows store lower-case entry names). */
+static char g_manifest_entry[160];
+
+static jboolean manifest_filter(const pcsl_string *name) {
+    char tmp[160];
+    int i, n = name->length;
+    if (n < 20 || n >= (int)sizeof(tmp)) {
+        return 0;
+    }
+    for (i = 0; i < n; i++) {
+        char ch = (char)(name->data[i] & 0xFF);
+        tmp[i] = (ch >= 'a' && ch <= 'z') ? (char)(ch - 32) : ch;
+    }
+    tmp[n] = '\0';
+    if (strncmp(tmp, "META-INF/", 9) != 0) {
+        return 0;
+    }
+    if (strcmp(tmp + n - 11, "MANIFEST.MF") != 0) {
+        return 0;
+    }
+    memcpy(g_manifest_entry, tmp, n);
+    g_manifest_entry[n] = '\0';
+    return 1;
+}
+
+static jboolean manifest_action(const pcsl_string *name) {
+    (void)name;
+    return 0;
+}
+
+/* The MIDlet class is the text after the LAST comma on the "MIDlet-1:"
+ * line (name/icon fields may contain commas, e.g. Chinese names). */
+static void parse_manifest_class(const char *jarpath, char *out, size_t outsz) {
+    pcsl_string jar_ps, entry_ps;
+    void *handle;
+    int jar_err;
+    unsigned char *buf = NULL;
+    long n = 0, i;
+    const char *entry = "META-INF/MANIFEST.MF";
+    out[0] = '\0';
+
+    make_pcsl_string(jarpath, &jar_ps);
+    handle = midpOpenJar(&jar_err, &jar_ps);
+    free_pcsl_string(&jar_ps);
+    if (handle == NULL) {
+        fprintf(stderr, "[menu] open jar failed: %s\n", jarpath);
+        return;
+    }
+
+    make_pcsl_string(entry, &entry_ps);
+    n = midpGetJarEntry(handle, &entry_ps, &buf);
+    free_pcsl_string(&entry_ps);
+
+    if (n <= 0 || buf == NULL) {
+        g_manifest_entry[0] = '\0';
+        midpIterateJarEntries(handle, manifest_filter, manifest_action);
+        if (g_manifest_entry[0] != '\0') {
+            make_pcsl_string(g_manifest_entry, &entry_ps);
+            n = midpGetJarEntry(handle, &entry_ps, &buf);
+            free_pcsl_string(&entry_ps);
+        }
+    }
+    midpCloseJar(handle);
+    if (n <= 0 || buf == NULL) {
+        fprintf(stderr, "[menu] no MANIFEST.MF inside %s\n", jarpath);
+        fflush(stderr);
+        if (buf != NULL) {
+            midpFree(buf);
+        }
+        return;
+    }
+
+    for (i = 0; i + 9 <= n; i++) {
+        if (buf[i] == 'M' && buf[i + 1] == 'I' && buf[i + 2] == 'D' &&
+            buf[i + 3] == 'l' && buf[i + 4] == 'e' && buf[i + 5] == 't' &&
+            buf[i + 6] == '-' && buf[i + 7] == '1' && buf[i + 8] == ':') {
+            long p = i + 9;
+            long lineEnd = p;
+            long lastComma = -1;
+            int len = 0;
+            char tmp[128];
+            while (lineEnd < n && buf[lineEnd] != '\n' && buf[lineEnd] != '\r') {
+                lineEnd++;
+            }
+            for (p = i + 9; p < lineEnd; p++) {
+                if (buf[p] == ',') {
+                    lastComma = p;
+                }
+            }
+            if (lastComma < 0) {
+                break;
+            }
+            p = lastComma + 1;
+            while (p < lineEnd && buf[p] == ' ') p++;
+            while (p < lineEnd && len < (int)sizeof(tmp) - 1) {
+                tmp[len++] = (char)buf[p++];
+            }
+            while (len > 0 && (tmp[len - 1] == ' ' || tmp[len - 1] == '\r')) {
+                len--;
+            }
+            tmp[len] = '\0';
+            strncpy(out, tmp, outsz - 1);
+            out[outsz - 1] = '\0';
+            break;
+        }
+    }
+    if (out[0] == '\0') {
+        long head = (n < 120) ? n : 120;
+        fprintf(stderr, "[menu] no MIDlet-1 line, manifest head (%ld):\n", n);
+        fwrite(buf, 1, head, stderr);
+        fprintf(stderr, "\n");
+    }
+    fflush(stderr);
+    midpFree(buf);
+}
+
+static void load_cfg(const GameEntry *g, char *cls, size_t cls_sz) {
+    char path[256];
+    SceUID fd;
+    cls[0] = '\0';
+    snprintf(path, sizeof(path), "%s/" CFG_NAME, g->dir);
+    fd = sceIoOpen(path, SCE_O_RDONLY, 0);
+    if (fd >= 0) {
+        char buf[256];
+        int n = sceIoRead(fd, buf, sizeof(buf) - 1);
+        sceIoClose(fd);
+        if (n > 0) {
+            char *nl;
+            buf[n] = '\0';
+            nl = strpbrk(buf, "\r\n");
+            if (nl != NULL) {
+                *nl = '\0';
+            }
+            strncpy(cls, buf, cls_sz - 1);
+            cls[cls_sz - 1] = '\0';
+        }
+    }
+}
+
+static void save_cfg(const GameEntry *g) {
+    char path[256];
+    SceUID fd;
+    snprintf(path, sizeof(path), "%s/" CFG_NAME, g->dir);
+    fd = sceIoOpen(path, SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
+    if (fd >= 0) {
+        char line[160];
+        int n = snprintf(line, sizeof(line), "%s\n%s\n",
+                         g->cls[0] ? g->cls : "-",
+                         g->landscape ? "landscape" : "portrait");
+        sceIoWrite(fd, line, n);
+        sceIoClose(fd);
+    }
+}
+
+static int dir_exists(const char *path) {
+    SceUID d = sceIoDopen(path);
+    if (d < 0) {
+        return 0;
+    }
+    sceIoDclose(d);
+    return 1;
+}
+
+static void scan_games(void) {
+    SceUID d;
+    SceIoDirent ent;
+    game_count = 0;
+    memset(games, 0, sizeof(games));
+
+    d = sceIoDopen(GAMES_DIR);
+    if (d < 0) {
+        return;
+    }
+    while (sceIoDread(d, &ent) > 0 && game_count < MAX_GAMES) {
+        GameEntry *g;
+        char cls[128];
+        if (!SCE_S_ISDIR(ent.d_stat.st_mode)) {
+            continue;
+        }
+        if (strcmp(ent.d_name, ".") == 0 || strcmp(ent.d_name, "..") == 0) {
+            continue;
+        }
+        g = &games[game_count];
+        snprintf(g->dir, sizeof(g->dir), GAMES_DIR "/%s", ent.d_name);
+        strncpy(g->name, ent.d_name, sizeof(g->name) - 1);
+        snprintf(g->jar, sizeof(g->jar), "%s/" JAR_NAME, g->dir);
+
+        g->landscape = 0;
+        load_cfg(g, cls, sizeof(cls));
+        if (cls[0] != '\0' && strcmp(cls, "-") != 0) {
+            strncpy(g->cls, cls, sizeof(g->cls) - 1);
+            {
+                char path[256];
+                SceUID fd = sceIoOpen(path, SCE_O_RDONLY, 0);
+                if (fd >= 0) {
+                    char buf[128];
+                    int n = sceIoRead(fd, buf, sizeof(buf) - 1);
+                    sceIoClose(fd);
+                    if (n > 0) {
+                        char *nl = strpbrk(buf, "\r\n");
+                        if (nl != NULL) {
+                            char *p2 = nl + 1 + strspn(nl + 1, "\r\n");
+                            if (strncmp(p2, "landscape", 9) == 0) {
+                                g->landscape = 1;
+                            }
+                        }
+                    }
+                }
+            }
+        } else {
+            parse_manifest_class(g->jar, g->cls, sizeof(g->cls));
+        }
+        game_count++;
+    }
+    sceIoDclose(d);
+}
+
+static void uninstall_game(GameEntry *g) {
+    char path[256];
+    snprintf(path, sizeof(path), "%s/" JAR_NAME, g->dir);
+    sceIoRemove(path);
+    snprintf(path, sizeof(path), "%s/" CFG_NAME, g->dir);
+    sceIoRemove(path);
+    sceIoRmdir(g->dir);
+}
+
+static void install_inbox(char *msg, size_t msg_sz) {
+    SceUID d;
+    SceIoDirent ent;
+    int installed = 0;
+
+    if (!dir_exists(INBOX_DIR)) {
+        sceIoMkdir(INBOX_DIR, 0777);
+    }
+    d = sceIoDopen(INBOX_DIR);
+    if (d < 0) {
+        snprintf(msg, msg_sz, "no inbox dir");
+        return;
+    }
+    while (sceIoDread(d, &ent) > 0) {
+        char src[256], dstjar[256], dstdir[200];
+        size_t blen;
+        char base[128];
+        if (SCE_S_ISDIR(ent.d_stat.st_mode)) {
+            continue;
+        }
+        blen = strlen(ent.d_name);
+        if (blen < 5 || strcmp(ent.d_name + blen - 4, ".jar") != 0) {
+            continue;
+        }
+        snprintf(base, sizeof(base), "%s", ent.d_name);
+        base[blen - 4] = '\0';
+
+        snprintf(dstdir, sizeof(dstdir), GAMES_DIR "/%s", base);
+        sceIoMkdir(dstdir, 0777);
+        snprintf(src, sizeof(src), INBOX_DIR "/%s", ent.d_name);
+        snprintf(dstjar, sizeof(dstjar), "%s/" JAR_NAME, dstdir);
+        if (sceIoRename(src, dstjar) < 0) {
+            continue;
+        }
+        installed++;
+        {
+            GameEntry tmp;
+            char cls[128];
+            memset(&tmp, 0, sizeof(tmp));
+            snprintf(tmp.dir, sizeof(tmp.dir), "%s", dstdir);
+            snprintf(tmp.jar, sizeof(tmp.jar), "%s/" JAR_NAME, dstdir);
+            parse_manifest_class(tmp.jar, cls, sizeof(cls));
+            snprintf(tmp.cls, sizeof(tmp.cls), "%s", cls);
+            tmp.landscape = 0;
+            save_cfg(&tmp);
+        }
+    }
+    sceIoDclose(d);
+    if (installed > 0) {
+        snprintf(msg, msg_sz, "installed %d game(s)", installed);
+    } else {
+        snprintf(msg, msg_sz, "inbox empty (copy .jar to %s)", INBOX_DIR);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Menu main loop                                                     */
+/* ------------------------------------------------------------------ */
+
+/* Dialog actions */
+enum { DLG_LAUNCH = 0, DLG_ORIENT, DLG_UNINSTALL, DLG_BACK, DLG_N };
+
+int vita_menu_run(VitaGameSel *out) {
+    int sel = 0;
+    int top = 0;
+    char msg[160] = "";
+    int have_selection = 0;
+    int mode = 0;          /* 0 = list, 1 = per-game dialog */
+    int dlg_sel = DLG_LAUNCH;
+    int dlg_confirm_del = 0;
+
+    if (menu_fb == NULL) {
+        menu_fb = (uint32_t *)memalign(0x100, FB_W * FB_H * 4);
+        if (menu_fb == NULL) {
+            return 0;
+        }
+    }
+    if (ft_init() != 0) {
+        fprintf(stderr, "[menu] freetype init failed, ASCII only\n");
+        fflush(stderr);
+    }
+    if (!dir_exists(GAMES_DIR)) {
+        sceIoMkdir(GAMES_DIR, 0777);
+    }
+    scan_games();
+
+    for (;;) {
+        unsigned int btn;
+        int tx, ty, tapped;
+        int i;
+        const int row_h = 34;
+        const int lines = 12;
+        int y;
+
+        btn = poll_buttons();
+        tapped = touch_tap(&tx, &ty);
+
+        if (mode == 0) {
+            /* ---------------- game list ---------------- */
+            if (btn & SCE_CTRL_UP) {
+                if (sel > 0) sel--;
+            }
+            if (btn & SCE_CTRL_DOWN) {
+                if (sel < game_count - 1) sel++;
+            }
+            if (sel < top) top = sel;
+            if (sel >= top + lines) top = sel - lines + 1;
+
+            if (tapped && tx >= 16 && tx <= 944 &&
+                ty >= 70 && ty < 70 + lines * row_h) {
+                int row = top + (ty - 70) / row_h;
+                if (row < game_count) {
+                    if (row == sel) {
+                        mode = 1;
+                        dlg_sel = DLG_LAUNCH;
+                        dlg_confirm_del = 0;
+                    } else {
+                        sel = row;
+                    }
+                }
+            }
+
+            if (btn & SCE_CTRL_START) {
+                install_inbox(msg, sizeof(msg));
+                scan_games();
+                if (sel >= game_count) sel = game_count - 1;
+                if (sel < 0) sel = 0;
+            }
+            if (btn & SCE_CTRL_SELECT) {
+                scan_games();
+                snprintf(msg, sizeof(msg), "rescanned: %d game(s)", game_count);
+            }
+            if ((btn & SCE_CTRL_CROSS) && game_count > 0) {
+                mode = 1;
+                dlg_sel = DLG_LAUNCH;
+                dlg_confirm_del = 0;
+            }
+            if ((btn & SCE_CTRL_CROSS) && game_count == 0) {
+                break; /* fall back to bundled demo */
+            }
+        } else {
+            /* ---------------- per-game dialog ---------------- */
+            int act_press = 0;
+            GameEntry *g = &games[sel];
+
+            if (tapped) {
+                if (tx >= 300 && tx <= 660 && ty >= 170 &&
+                    ty <= 170 + 40 + DLG_N * 44) {
+                    int item = (ty - 170 - 40) / 44;
+                    if (item >= 0 && item < DLG_N) {
+                        dlg_sel = item;
+                        act_press = 1;
+                    }
+                } else {
+                    mode = 0;
+                    dlg_confirm_del = 0;
+                }
+            }
+
+            if (btn & SCE_CTRL_UP) {
+                if (dlg_sel > 0) dlg_sel--;
+            }
+            if (btn & SCE_CTRL_DOWN) {
+                if (dlg_sel < DLG_N - 1) dlg_sel++;
+            }
+            if (btn & SCE_CTRL_CIRCLE) {
+                mode = 0;
+                dlg_confirm_del = 0;
+            }
+            if ((btn & SCE_CTRL_CROSS) || act_press) {
+                int act = dlg_sel;
+                if (act == DLG_ORIENT) {
+                    g->landscape = !g->landscape;
+                    save_cfg(g);
+                    snprintf(msg, sizeof(msg), "%s: %s", g->name,
+                             g->landscape ? "landscape" : "portrait");
+                } else if (act == DLG_UNINSTALL) {
+                    if (!dlg_confirm_del) {
+                        dlg_confirm_del = 1;
+                    } else {
+                        uninstall_game(g);
+                        snprintf(msg, sizeof(msg), "deleted %s", g->name);
+                        dlg_confirm_del = 0;
+                        mode = 0;
+                        scan_games();
+                        if (sel >= game_count) sel = game_count - 1;
+                        if (sel < 0) sel = 0;
+                    }
+                } else if (act == DLG_BACK) {
+                    mode = 0;
+                    dlg_confirm_del = 0;
+                } else if (act == DLG_LAUNCH) {
+                    char cls[128];
+                    load_cfg(g, cls, sizeof(cls));
+                    if (cls[0] != '\0' && strcmp(cls, "-") != 0) {
+                        strncpy(g->cls, cls, sizeof(g->cls) - 1);
+                    }
+                    if (g->cls[0] == '\0') {
+                        parse_manifest_class(g->jar, g->cls, sizeof(g->cls));
+                    }
+                    if (g->cls[0] == '\0') {
+                        snprintf(msg, sizeof(msg),
+                                 "%s: no MIDlet class (see log)", g->name);
+                    } else {
+                        save_cfg(g);
+                        memset(out, 0, sizeof(*out));
+                        snprintf(out->jar, sizeof(out->jar), "%s", g->jar);
+                        snprintf(out->cls, sizeof(out->cls), "%s", g->cls);
+                        snprintf(out->orient, sizeof(out->orient), "%s",
+                                 g->landscape ? "landscape" : "portrait");
+                        have_selection = 1;
+                        fprintf(stderr, "[menu] launching %s (%s)\n",
+                                g->name, g->cls);
+                        fflush(stderr);
+                        break;
+                    }
+                }
+            }
+        }
+
+        /* ---------------- draw ---------------- */
+        fill_rect(0, 0, FB_W, FB_H, C_BG);
+        fill_rect(0, 0, FB_W, 56, C_PANEL);
+        ui_text(20, 14, C_TITLE, 30, "J2ME Player");
+        ui_textf(800, 20, C_HINT, 20, "%d game(s)", game_count);
+
+        y = 70;
+        for (i = top; i < game_count && i < top + lines; i++) {
+            if (i == sel) {
+                fill_rect(16, y - 4, 928, row_h, C_SEL);
+            }
+            ui_text(28, y + 8, C_FG, 22, games[i].name);
+            ui_text(860, y + 8,
+                    games[i].landscape ? C_DIRT : C_HINT, 22,
+                    games[i].landscape ? "L" : "P");
+            if (games[i].cls[0] == '\0') {
+                ui_text(888, y + 8, C_WARN, 22, "?");
+            }
+            y += row_h;
+        }
+        if (game_count == 0) {
+            ui_text(28, y + 14, C_WARN, 22, "no games installed");
+            ui_text(28, y + 46, C_WARN, 22,
+                    "copy .jar files with VitaShell to:");
+            ui_text(28, y + 78, C_FG, 22, INBOX_DIR);
+            ui_text(28, y + 110, C_WARN, 22,
+                    "then press START to install");
+        }
+
+        if (msg[0] != '\0') {
+            ui_text(20, 462, C_FG, 22, msg);
+        }
+
+        if (mode == 1 && game_count > 0) {
+            GameEntry *g = &games[sel];
+            fill_rect(0, 0, FB_W, FB_H, 0x90000000u);
+            fill_rect(300, 170, 360, 60 + DLG_N * 44, C_PANEL);
+            fill_rect(300, 170, 360, 3, C_TITLE);
+            ui_text(320, 190, C_TITLE, 24, g->name);
+            for (i = 0; i < DLG_N; i++) {
+                int iy = 170 + 50 + i * 44;
+                const char *label;
+                if (i == DLG_ORIENT) {
+                    label = g->landscape ? "orientation: landscape"
+                                         : "orientation: portrait";
+                } else if (i == DLG_UNINSTALL) {
+                    label = dlg_confirm_del ? "confirm delete?" : "uninstall";
+                } else if (i == DLG_LAUNCH) {
+                    label = "launch game";
+                } else {
+                    label = "back";
+                }
+                if (i == dlg_sel) {
+                    fill_rect(310, iy - 6, 340, 38, C_SEL);
+                }
+                ui_text(326, iy, (i == dlg_sel) ? C_FG : C_HINT, 22, label);
+            }
+        } else {
+            ui_text(20, 512, C_HINT, 18,
+                    "UP/DOWN select   X open   START install inbox   "
+                    "SEL rescan");
+        }
+
+        {
+            SceDisplayFrameBuf fb;
+            memset(&fb, 0, sizeof(fb));
+            fb.size = sizeof(SceDisplayFrameBuf);
+            fb.base = menu_fb;
+            fb.pitch = FB_W;
+            fb.pixelformat = SCE_DISPLAY_PIXELFORMAT_A8B8G8R8;
+            fb.width = FB_W;
+            fb.height = FB_H;
+            sceDisplaySetFrameBuf(&fb, SCE_DISPLAY_SETBUF_IMMEDIATE);
+        }
+        sceDisplayWaitVblankStart();
+    }
+
+    free(menu_fb);
+    menu_fb = NULL;
+    ft_shutdown();
+    fprintf(stderr, "[menu] menu resources released, handing to JVM\n");
+    fflush(stderr);
+    return have_selection;
+}
