+ * OS_vita.hpp: PS Vita OS-specific declarations.
+ *
+ * Vita uses newlib which provides most POSIX headers.
+ * No mmap, no signals for VM exceptions, no ucontext.
+ */
+
+#ifndef  __USE_GNU
