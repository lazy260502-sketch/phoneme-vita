+                scanEndOffset = offset;
+                break;
+            }
+
+            try {
+                dbFile.seek(offset);
+                readBack = dbFile.read(header, 0, BLOCK_HEADER_SIZE);
+            } catch (java.io.IOException ioe) {
+                scanEndOffset = offset;
+                break;
+            }
+            if (readBack != BLOCK_HEADER_SIZE) {
+                scanEndOffset = offset;
+                break; /* physical EOF: nothing more to salvage */
+            }
