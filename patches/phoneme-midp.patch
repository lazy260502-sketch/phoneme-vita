@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+"""
+Generate stub classes for all missing dependencies.
+
+This script creates minimal stub classes that allow the MIDP core
+classes to compile and provide a working runtime.
+"""
+import os
+import sys
+
+# Base directory
+BASE = sys.argv[1] if len(sys.argv) > 1 else "."
+
+# Stub class template
+STUB_CLASS = """/*
+ * Stub class - minimal implementation
+ * Generated by gen_stubs.py
+ */
+package {package};
+
+/**
+ * Stub implementation - NOT FUNCTIONAL
+ */
+public class {classname}{extends} {{
+    // Empty stub
+}}
+"""
+
+STUB_INTERFACE = """/*
+ * Stub interface - minimal implementation
+ * Generated by gen_stubs.py
+ */
+package {package};
+
+/**
+ * Stub interface - NOT FUNCTIONAL
+ */
+public interface {classname} {{
+    // Empty stub
+}}
+"""
+
+# List of stub classes to create
+STUBS = [
+    # com.sun.midp.midlet
+    ("com.sun.midp.midlet", "MIDletPeer", "class", ""),
+    ("com.sun.midp.midlet", "MIDletStateHandler", "class", ""),
+
+    # com.sun.midp.security
+    ("com.sun.midp.security", "SecurityInitializer", "class", ""),
+    ("com.sun.midp.security", "ImplicitlyTrustedClass", "interface", ""),
+
+    # com.sun.midp.chameleon
+    ("com.sun.midp.chameleon", "MIDPWindow", "class", ""),
+    ("com.sun.midp.chameleon", "CGraphicsQ", "class", ""),
+    ("com.sun.midp.chameleon", "ChamDisplayTunnel", "class", ""),
+    ("com.sun.midp.chameleon.input", "TextInputSession", "class", ""),
+    ("com.sun.midp.chameleon.input", "BasicTextInputSession", "class", ""),
+    ("com.sun.midp.chameleon.input", "NativeInputMode", "class", ""),
+    ("com.sun.midp.chameleon.layers", "PopupLayer", "class", ""),
+    ("com.sun.midp.chameleon.layers", "PTILayer", "class", ""),
+    ("com.sun.midp.chameleon.layers", "VirtualKeyboardLayer", "class", ""),
+    ("com.sun.midp.chameleon.layers", "VirtualKeyListener", "interface", ""),
+    ("com.sun.midp.chameleon.skins", "ChoiceGroupSkin", "class", ""),
+    ("com.sun.midp.chameleon.skins", "ScreenSkin", "class", ""),
+    ("com.sun.midp.chameleon.skins.resources", "SkinResources", "class", ""),
+    ("com.sun.midp.chameleon.skins.resources", "SkinResourcesImpl", "class", ""),
+    ("com.sun.midp.chameleon.skins.resources", "SkinLoader", "class", ""),
+
+    # com.sun.midp.orientation
+    ("com.sun.midp.orientation", "OrientationListener", "interface", ""),
+
+    # com.sun.midp.util
+    ("com.sun.midp.util", "LiveTracer", "class", ""),
+
+    # com.sun.midp.main
+    ("com.sun.midp.main", "MIDletSuiteLoader", "class", ""),
+    ("com.sun.midp.main", "Configuration", "class", ""),
+    ("com.sun.midp.main", "CommandState", "class", ""),
+
+    # com.sun.me.gci.windowsystem
+    ("com.sun.me.gci.windowsystem", "GCIGraphicsEnvironment", "class", ""),
+    ("com.sun.me.gci.windowsystem", "GCIDisplay", "class", ""),
+    ("com.sun.me.gci.windowsystem", "GCIScreenWidget", "class", ""),
+
+    # javax.microedition.media
+    ("javax.microedition.media", "Manager", "class", ""),
+    ("javax.microedition.media", "MediaException", "class", " extends RuntimeException"),
+    ("javax.microedition.media", "Player", "interface", ""),
+    ("javax.microedition.media", "Control", "interface", ""),
+    ("javax.microedition.media.control", "ToneControl", "interface", ""),
+    ("javax.microedition.media.control", "VolumeControl", "interface", ""),
+]
+
+
+def create_stub(package, classname, kind, extra):
+    """Create a stub class file."""
+    pkg_path = package.replace('.', '/')
+    dir_path = os.path.join(BASE, pkg_path)
+    os.makedirs(dir_path, exist_ok=True)
+
+    file_path = os.path.join(dir_path, classname + ".java")
+
+    if kind == "class":
+        template = STUB_CLASS
+        if extra:
+            content = template.format(
+                package=package, classname=classname,
+                extends=extra
+            )
+        else:
+            content = template.format(
+                package=package, classname=classname, extends=""
+            )
+    else:  # interface
+        content = STUB_INTERFACE.format(
+            package=package, classname=classname
+        )
+
+    with open(file_path, 'w') as f:
+        f.write(content)
+    print(f"Created: {file_path}")
+
+
+def main():
+    for package, classname, kind, extra in STUBS:
+        create_stub(package, classname, kind, extra)
+    print(f"\nTotal: {len(STUBS)} stub classes created")
+
+
+if __name__ == '__main__':
+    main()
