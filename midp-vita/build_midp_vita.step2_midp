#!/bin/bash
# Step 2: Update MIDP libobj if needed

source "$(dirname "${BASH_SOURCE[0]}")/build_midp_vita.common"

build_section "[Step 2] Checking MIDP modifications..."

MIDP_SRC="$MIDP_DIR/src/ams/ams_base_cldc/reference/native/midp_run.c"
LOCAL_MAIN="$SCRIPT_DIR/src/main.c"

REBUILD_MIDP=0

if file_changed "$MIDP_SRC" "$BUILD_DIR/.midp_src.md5"; then
    build_info "Changed: midp_run.c"
    REBUILD_MIDP=1
fi

if file_changed "$LOCAL_MAIN" "$BUILD_DIR/.midp_main.md5"; then
    build_info "Changed: main.c"
    REBUILD_MIDP=1
fi

# Rebuild if CLDC was rebuilt
if [ "$REBUILD_CLDC" = "1" ]; then
    build_info "CLDC changed, rebuilding MIDP"
    REBUILD_MIDP=1
fi

if [ "$REBUILD_MIDP" = "1" ]; then
    build_info "Rebuilding MIDP libobj..."
    cd "$BUILD_DIR"
    rm -f libobj_target libobj_no_main.a
    md5sum "$MIDP_SRC" | cut -d' ' -f1 > "$BUILD_DIR/.midp_src.md5"
    md5sum "$LOCAL_MAIN" | cut -d' ' -f1 > "$BUILD_DIR/.midp_main.md5"
    build_success "MIDP rebuilt"
else
    build_info "MIDP up to date"
fi

export REBUILD_MIDP
