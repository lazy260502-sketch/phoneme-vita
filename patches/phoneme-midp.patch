+        byte[] header = new byte[BLOCK_HEADER_SIZE];
+        int offset = DB_HEADER_SIZE;
+        int seenLive = 0;
+
+        while (offset < dbSize) {
+            try {
+                dbFile.seek(offset);
+                if (dbFile.read(header) != BLOCK_HEADER_SIZE) {
+                    return false;
+                }
+            } catch (java.io.IOException ioe) {
+                return false;
+            }
