# build/vita_arm: keep only hand-written platform config & scripts,
# ignore all generated output (ROMImage_*.cpp, binaries, target/, dist/, ...)
/build/vita_arm/*
!/build/vita_arm/Makefile
!/build/vita_arm/vita_arm.cfg
!/build/vita_arm/vita_arm.mk
!/build/vita_arm/embed_midp.py

